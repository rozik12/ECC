# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 24
LP_DOMAIN=apps.example.com
LP_API_TOKEN=
LP_NODE_TOKEN=
POSTGRES_PASSWORD=
ACME_EMAIL=you@example.com
# Interface the dashboard/API listens on. 127.0.0.1 keeps it private (recommended
# behind a TLS reverse proxy); use 0.0.0.0 only if something else secures it.
LP_BIND=127.0.0.1
